# Configuration locale de l’IDE.
/.idea/

# Donnees d'execution du module JDR. Seuls les fichiers de protection et le
# placeholder du dossier restent versionnes.
/map/data/*
!/map/data/.gitkeep
!/map/data/.htaccess

# Fichiers temporaires crees par SQLite selon son mode de journalisation.
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal

# Comptes, bibliothèques, sauvegardes et fichiers téléversés de SuSZic.
/data/*
!/data/.htaccess
/uploads/audio/*
!/uploads/audio/.gitkeep
!/uploads/audio/.htaccess
/uploads/images/*
!/uploads/images/.htaccess
